# NearStock — copy to .env and fill in to run against MySQL.
# Leave everything commented out to use the seeded in-memory dataset.

# Option A — a single connection string
# DATABASE_URL=mysql://user:password@host:3306/nearstock

# Option B — discrete variables
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=secret
# DB_NAME=nearstock
# DB_SSL=false
# DB_POOL_SIZE=5

# PORT=3000
